# Preview never calls the backend or accepts real documents/identifiers.
IDENTITY_PORTAL_MODE=preview
# Match the backend provider. FIMS mode skips external capture and screening.
IDENTITY_IDENTIFIER_PROVIDER=fims
# Enable only after the private backend worker is configured.
IDENTITY_BIOMETRIC_MODE=off
# To connect a synthetic staging account, explicitly set mode to staging.
IDENTITY_BACKEND_URL=http://127.0.0.1:3000
IDENTITY_WEB_ORIGIN=http://127.0.0.1:3002
# Exact private staging S3 origin, also used by the CSP and upload validation.
IDENTITY_UPLOAD_ORIGIN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
